# Base de datos PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rosapasion?schema=public"

# Clave secreta para generación y validación de tokens JWT (HttpOnly Cookies)
JWT_SECRET="super-secret-jwt-key-rosa-pasion-club-2026-secure-token-hash"

# URL base de la aplicación
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Credenciales por defecto para el script de seed
DEFAULT_ADMIN_EMAIL="admin@rosapasion.com"
DEFAULT_ADMIN_PASSWORD="AdminPassword2026!"
DEFAULT_ADMIN_NAME="Administrador Rosa Pasión"

# (Opcional - Producción) Almacenamiento en la Nube con Cloudinary (Imágenes y Logos)
# Si no se definen, el sistema guardará las imágenes localmente en /public/uploads/logos
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# (Opcional - Producción) Token de seguridad para el Cron Job diario (/api/cron/sync-members)
CRON_SECRET="rosa-pasion-cron-secret-token-2026"
