datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  EDITOR
}

enum MemberStatus {
  ACTIVA
  VENCIDA
  SUSPENDIDA
}

enum PaymentStatus {
  PENDIENTE
  APROBADO
  RECHAZADO
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Category {
  id         String     @id @default(cuid())
  name       String     @unique
  slug       String     @unique
  iconName   String     @default("Sparkles")
  order      Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  businesses Business[]

  @@map("categories")
}

model Business {
  id              String         @id @default(cuid())
  categoryId      String
  category        Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name            String         @unique
  slug            String         @unique
  logoUrl         String?
  discountSummary String
  whatsappNumber  String
  storeCode       String         @default("1234")
  validUntil      DateTime?
  isActive        Boolean        @default(true)
  order           Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?
  terms           BusinessTerm[]
  history         HistoryLog[]

  @@index([deletedAt])
  @@index([isActive, order])
  @@map("businesses")
}

model BusinessTerm {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  description String
  isRule      Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([businessId])
  @@map("business_terms")
}

model Member {
  id             String        @id @default(cuid())
  code           String        @unique // Ej: RPC-0001
  name           String
  documentType   String        @default("DNI") // DNI, CE, PASAPORTE
  documentNumber String?       @unique // DNI o Carnet de Extranjería único
  email          String?
  phone          String?
  validFrom      DateTime      @default(now())
  validUntil     DateTime
  status         MemberStatus  @default(ACTIVA)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  history        HistoryLog[]
  payments       MembershipPayment[]

  @@index([deletedAt])
  @@index([status, validUntil])
  @@index([createdAt(sort: Desc)])
  @@map("members")
}

model HistoryLog {
  id              String    @id @default(cuid())
  memberId        String?
  member          Member?   @relation(fields: [memberId], references: [id], onDelete: SetNull)
  memberCode      String    // Ej: RPC-0001
  memberName      String    // Ej: Orison David
  businessId      String?
  business        Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  businessName    String    // Ej: Master Ulala
  discountApplied String    // Ej: 15% de Descuento en Lavado
  notes           String?
  createdAt       DateTime  @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([memberCode])
  @@index([businessId])
  @@index([memberId])
  @@map("history_logs")
}

model MembershipPayment {
  id              String        @id @default(cuid())
  memberId        String?
  member          Member?       @relation(fields: [memberId], references: [id], onDelete: SetNull)
  memberCode      String        // Ej: RPC-0001
  memberName      String        // Nombre del titular
  documentNumber  String        // DNI o CE
  phone           String        // Celular / WhatsApp
  planName        String        @default("Membresía Mensual (30 Días)")
  amount          Decimal       @default(29.00) @db.Decimal(10, 2)
  paymentMethod   String        @default("YAPE") // YAPE, PLIN, TRANSFERENCIA
  operationNumber String?       // Nro de operación / referencia
  voucherUrl      String?       // Foto / captura del comprobante
  status          PaymentStatus @default(PENDIENTE)
  notes           String?
  approvedAt      DateTime?
  approvedBy      String?
  rejectedReason  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([documentNumber])
  @@index([memberCode])
  @@index([createdAt(sort: Desc)])
  @@map("membership_payments")
}

model ClubSetting {
  id               String   @id @default("default")
  qrRedirectUrl    String   @default("https://rosapasionclub.com")
  catalogUrl       String   @default("https://wa.me/51952226282?text=Hola%20Rosa%20Pasión,%20quiero%20ver%20su%20catálogo%20actualizado")
  supportPhone     String   @default("51952226282")
  yapePhone        String   @default("952 226 282")
  yapeName         String   @default("Rosa Pasión Flores y Detalles")
  yapeQrUrl        String?  @default("/yape-qr.png")
  plinPhone        String   @default("952 226 282")
  plinQrUrl        String?  @default("/plin-qr.png")
  bcpAccount       String?  @default("550-95549542-0-21")
  bcpCci           String?  @default("00255010932545818821")
  interbankAccount String?  @default("8983150419001")
  interbankCci     String?  @default("")
  bbvaAccount      String?  @default("0011-0814-0203826899")
  bbvaCci          String?  @default("")
  bankBeneficiary  String?  @default("Orison David Cometivos Rojas")
  bankAccounts     Json?
  membershipPrice  Decimal  @default(29.00) @db.Decimal(10, 2)
  updatedAt        DateTime @updatedAt

  @@map("club_settings")
}
